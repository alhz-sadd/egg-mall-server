# ==========================================
# Egg.js 环境变量配置模板 (.env.example)
# 请复制此文件并重命名为 .env，然后填入真实的配置信息
# ==========================================

# ----------------- OSS 配置 -----------------
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=
OSS_BUCKET=

# ----------------- 基础配置 -----------------
APP_BASE_URL=

# ----------------- 数据库配置 -----------------
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USER=
DB_PASSWORD=

# ----------------- Redis 配置 -----------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ----------------- 安全配置 -----------------
JWT_SECRET=
