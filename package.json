{
  "name": "egg-mall-server",
  "version": "1.0.0",
  "description": "基于 Egg.js 的商城后端服务",
  "private": true,
  "egg": {
    "declarations": true
  },
  "scripts": {
    "start": "egg-scripts start --daemon --title=egg-server-egg-mall-server",
    "stop": "egg-scripts stop --title=egg-server-egg-mall-server",
    "dev": "egg-bin dev",
    "debug": "egg-bin debug",
    "test": "npm run lint -- --fix && npm run test-local",
    "test-local": "egg-bin test",
    "cov": "egg-bin cov",
    "lint": "eslint .",
    "ci": "npm run lint && npm run cov",
    "autod": "autod"
  },
  "dependencies": {
    "dayjs": "^1.11.10",
    "egg": "^3.17.0",
    "egg-bcrypt": "^1.1.0",
    "egg-cors": "^2.2.4",
    "egg-jwt": "^3.1.7",
    "egg-redis": "^2.6.1",
    "egg-scripts": "^2.15.0",
    "egg-sequelize": "^6.0.0",
    "egg-swagger-doc": "^2.3.2",
    "google-translate-api-x": "^10.7.3",
    "ip2region": "^2.3.0",
    "lodash": "^4.17.21",
    "mysql2": "^3.9.0",
    "qrcode": "^1.5.4",
    "speakeasy": "^2.0.0",
    "translate-google": "^1.5.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "autod": "^3.1.2",
    "egg-bin": "^6.4.0",
    "egg-ci": "^2.1.0",
    "egg-mock": "^5.10.0",
    "eslint": "^8.57.0",
    "eslint-config-egg": "^12.3.0",
    "sequelize-cli": "^6.6.5",
    "sqlite3": "^6.0.1"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
